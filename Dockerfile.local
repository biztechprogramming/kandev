# Local layer on top of the universal image (built by the kandev-base service
# in docker-compose.yml): SSH client for git pushes and the current GitHub CLI.
FROM base

USER root

RUN set -eux; \
    mkdir -p -m 755 /etc/apt/keyrings; \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /etc/apt/keyrings/githubcli-archive-keyring.gpg; \
    chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg; \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends openssh-client gh; \
    rm -rf /var/lib/apt/lists/*

# pnpm through corepack, matching the host: each project gets the pnpm version
# in its "packageManager" field, otherwise corepack's default (lastKnownGood).
# Replaces the fixed pnpm the universal image installs with npm.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN set -eux; \
    npm uninstall -g --prefix /usr/local pnpm; \
    corepack enable --install-directory /usr/local/bin pnpm

USER kandev
